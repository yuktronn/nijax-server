datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  APPLICANT
}

enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
  UNDER_REVIEW
  SELECTION_PENDING
  WINNER_SELECTED
  PROJECT_ACTIVE
  COMPLETED
  ARCHIVED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUALIFIED
  SHORTLISTED
  SELECTED
  NOT_SELECTED
  PROJECT_ACTIVE
  PROJECT_COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  REQUIREMENTS
  DESIGN
  DEVELOPMENT
  TESTING
  DEPLOYED
  FEEDBACK_PENDING
  COMPLETED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         Role       @default(APPLICANT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  applications Application[]
  auditLogs    AuditLog[]
}

model PilotCycle {
  id                  String        @id @default(uuid())
  name                String
  month               Int
  year                Int
  status              CycleStatus   @default(DRAFT)
  applicationStartAt  DateTime
  applicationEndAt    DateTime
  selectionAt         DateTime
  eligibleLocation    String        @default("Chennai")
  projectCategories   String        @default("Website, CRM, Booking System, Automation")
  monthlyProjectLimit Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  applications        Application[]
}

model Application {
  id                  String            @id @default(uuid())
  pilotCycleId        String
  pilotCycle          PilotCycle        @relation(fields: [pilotCycleId], references: [id], onDelete: Cascade)
  applicantId         String
  applicant           User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  businessName        String
  businessType        String
  businessDescription String
  website             String?
  phone               String
  email               String
  location            String
  targetAudience      String
  requestedSolution   String
  businessChallenge   String
  projectDescription  String?
  referralSource      String
  status              ApplicationStatus @default(SUBMITTED)
  leadStatus          LeadStatus?
  notes               String?
  priority            String            @default("MEDIUM")
  rejectionReason     String?
  submittedAt         DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  selection           Selection?
  project             Project?
  emailLogs           EmailLog[]
  auditLogs           AuditLog[]
}

model Selection {
  id              String      @id @default(uuid())
  applicationId   String      @unique
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  selectedAt      DateTime    @default(now())
  selectionMethod String      @default("ADMIN")
  adminId         String
  notes           String?
}

model Project {
  id                 String        @id @default(uuid())
  applicationId      String        @unique
  application        Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  projectType        String
  scope              String
  startDate          DateTime
  targetCompletionDate DateTime
  status             ProjectStatus @default(PLANNING)
  requirements       String
  deploymentUrl      String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  feedback           Feedback?
}

model Feedback {
  id                     String      @id @default(uuid())
  projectId              String      @unique
  project                Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rating                 Int
  writtenFeedback        String
  testimonial            String?
  videoTestimonialUrl    String?
  permissionToPublish    Boolean     @default(false)
  permissionToUseLogo    Boolean     @default(false)
  permissionToUseProject Boolean     @default(false)
  submittedAt            DateTime    @default(now())
}

model EmailLog {
  id            String       @id @default(uuid())
  recipient     String
  emailType     String
  status        String
  sentAt        DateTime     @default(now())
  error         String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id            String       @id @default(uuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  details       String?
  ipAddress     String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
}

model Service {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  shortDescription String
  description      String
  icon             String    @default("FiLayers")
  aiContext        String?
  isActive         Boolean   @default(true)
  displayOrder     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model CampaignSettings {
  id                String   @id @default("default")
  campaignTitle     String   @default("Your business could be our next Digital Pilot.")
  campaignSubtitle  String   @default("Each month, Yuktron selects one business for a Digital Pilot.")
  selectionCount    Int      @default(1)
  offerMessage      String   @default("Selected businesses receive the pilot at no project cost.")
  supportingMessage String   @default("Selected businesses receive the pilot at no project cost.")
  applicationOpen   DateTime @default(now())
  applicationClose  DateTime @default(now())
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model OtpVerification {
  id          String   @id @default(uuid())
  email       String   @unique
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  email        String?
  formData     Json?
  currentState String   @default("WELCOME")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     ConversationMessage[]
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // "nijax" | "user"
  text           String
  createdAt      DateTime     @default(now())
}

